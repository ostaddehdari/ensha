APP_NAME=Ensha
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://srun.ir/ensha

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ensha
DB_USERNAME=ensha
DB_PASSWORD=change-this-password

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/ensha
SESSION_DOMAIN=
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@srun.ir"
MAIL_FROM_NAME="${APP_NAME}"

ENSHA_DEFAULT_CENTER="مرکز مشاوره انشا"
